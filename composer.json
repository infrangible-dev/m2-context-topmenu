{
    "name": "infrangible/m2-context-topmenu",
    "description": "Lets the top navigation menu differ by customer context, such as customer group, without wrong menus being served from the cache.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Performance",
        "Customers",
        "menu per customer group",
        "customer group specific navigation",
        "top menu by customer context"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-context-topmenu",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\ContextTopmenu\\": "src"
        }
    }
}
